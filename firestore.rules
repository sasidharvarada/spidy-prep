rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Spidy ECE Prep: each signed-in user can read and write only their own progress.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Old Embedded Tracker document. Keep it readable so the new site can import it.
    // While the old tracker is still in use it also needs write access (it has no sign-in).
    // When you stop using the old tracker, change "write: if true" to "write: if false".
    match /progress/main {
      allow read: if true;
      allow write: if true;
    }
  }
}
