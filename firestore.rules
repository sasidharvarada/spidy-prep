rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Spidy ECE Prep: each signed-in user can read and write only their own progress.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Old Embedded Tracker document. Keep it readable to authenticated users so the
    // new site can import it, but never allow the public client to overwrite it.
    match /progress/main {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
